; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Arthesia-map"
run/main_scene="res://scenes/zones/floor_1/village_aube.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/arthesia_pixel.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
