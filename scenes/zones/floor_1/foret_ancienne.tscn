[node name="isarn_presence" type="Node2D" parent="Monde" unique_id=639729655]
position = Vector2(344, 336)
script = ExtResource("48_bs04t")
entry_id = "isarn_presence"
template_type = "npc"
template_id = "isarn_bucheron"
display_name = "Isarn"
role = "Bûcheron"
dialogues = PackedStringArray("Ce bois ne pourrit pas. Je coupe des arbres tombés il y a cent ans, et ils sont aussi frais qu\'hier.", "Il y a des troncs que je ne touche pas. Tu les reconnaîtras : ceux dont l\'écorce dessine des cercles.", "Mon grand-père disait que la forêt était plus vieille que l\'aube. Je ne sais même pas ce que ça veut dire.")
quests = [{
"entry_id": "quete_bois",
"name": "Le Bois qui ne Vieillit Pas",
"quest_id": "le_bois_qui_ne_vieillit_pas",
"spawn": {
