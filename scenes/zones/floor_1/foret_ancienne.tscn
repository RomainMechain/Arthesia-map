"type": "quest"
},
"cooldown_seconds": null,
"hint": "Isarn évite de regarder certains troncs, comme s'il y avait vu quelque chose qu'il préférerait oublier.",
"mode": "conditional",
"stock": null,
"visibility_when_locked": "hinted"
}
}]

