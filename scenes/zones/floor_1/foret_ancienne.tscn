[node name="lignes_sous_la_mousse" type="Node2D" parent="Monde" unique_id=2114364971]
position = Vector2(888, 214)
script = ExtResource("48_bs04t")
entry_id = "lignes_sous_la_mousse"
template_type = "discovery"
template_id = "lignes_sous_la_mousse"
display_name = "Les lignes sous la mousse"
role = "Découverte"
dialogues = PackedStringArray("Sous la mousse des sept pierres, les motifs ne sont pas sculptés : ils sont tracés, d\'un seul trait, sans reprise, comme par une main qui n\'hésitait jamais. Les lignes ne décrivent rien. Elles relient. Et quand on suit la plus longue du regard, elle ne s\'arrête pas à la pierre : elle continue dans l\'écorce des chênes morts, juste à côté.")
data = {
"note": "lignes_sous_la_mousse",
"title": "Les lignes sous la mousse"
}

