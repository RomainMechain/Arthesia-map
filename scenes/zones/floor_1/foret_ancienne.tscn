role = "Traqueuse"
dialogues = PackedStringArray("Un cerf blanc. Trop blanc. Ses traces ne s\'enfoncent pas dans la boue comme celles d\'une vraie bête.", "Toutes les pistes de cette forêt finissent par tourner en rond. La sienne, elle, va tout droit.", "Les ours ne gardaient pas les sentiers, avant. Maintenant, ils se postent tous du même côté de la forêt.")
