template_id = "maelis_passeuse"
display_name = "Maëlis"
role = "Passeuse"
dialogues = PackedStringArray("Je fais traverser jusqu\'aux roseaux, pas plus loin. Le milieu du lac est trop calme, ça ne me plaît pas.", "Ma grand-mère disait qu\'on entendait chanter sous l\'eau, certains matins. Elle disait aussi que tous les matins se ressemblent.", "Les anguilles remontent de plus en plus près. Elles ont la peau qui brille, maintenant. Avant, non.")
