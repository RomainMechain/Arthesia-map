[node name="cercle_immerge" type="Node2D" parent="Monde" unique_id=994814362]
position = Vector2(1048, 198)
script = ExtResource("54_k846y")
entry_id = "cercle_immerge"
template_type = "discovery"
template_id = "cercle_immerge"
display_name = "Cercle immergé"
role = "Découverte"
dialogues = PackedStringArray("Sous l\'eau claire de l\'anse, sept pierres taillées dessinent un cercle parfait. Leurs runes, d\'un cyan presque éteint, battent au même rythme que la lumière de l\'aube : une fois, puis rien, puis une fois. Ce n\'est pas un ouvrage de pêcheurs. Quelqu\'un, avant le village, a voulu que le lac garde quelque chose.")
data = {
"note": "cercle_immerge",
"title": "Le cercle sous l'îlot"
}

