script = ExtResource("54_k846y")
entry_id = "bertold_presence"
template_type = "npc"
template_id = "bertold_ravaudeur"
display_name = "Bertold"
role = "Ravaudeur de filets"
dialogues = PackedStringArray("Mes filets ne s\'usent pas comme avant. Ils se déchirent toujours au même endroit, comme si quelque chose tirait dessus, en bas.", "Les truites argentées ? Elles nagent dans l\'anse depuis que je suis gamin. Les mêmes, j\'en jurerais.", "Ne t\'avance pas au-delà des roseaux. Personne ne pêche plus loin, et personne ne se souvient vraiment pourquoi.")
