role = "Pêcheur"
dialogues = PackedStringArray("L\'eau ne bouge presque jamais ici. C\'est étrange, pour un lac vivant.", "Il y a une truite argentée, là-dessous, qui ne ressemble à aucune autre. Je n\'ai jamais réussi à la ferrer.", "Ramène-la-moi, et je te raconterai ce que j\'ai vu flotter sous la surface, une nuit qui n\'existait pas.")
