"spawn": {
"condition": {
"quest_id": "silence_des_bois",
"state": "completed",
"type": "quest"
},
"cooldown_seconds": null,
"hint": "On murmure que des motifs étranges se cachent sous l'écorce et sous l'eau du lac.",
"mode": "conditional",
"stock": null,
"visibility_when_locked": "hinted"
}
}, {
"entry_id": "quest_lumiere_vacille",
"name": "La Lumière qui ne Vacille Jamais",
"quest_id": "lumiere_qui_ne_vacille_jamais",
"spawn": {
"condition": {
