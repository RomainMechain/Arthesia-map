[node name="npc_yvenne" type="Node2D" parent="Monde" unique_id=1353103549]
position = Vector2(520, 464)
script = ExtResource("63_6v6ld")
entry_id = "npc_yvenne"
template_type = "npc"
template_id = "yvenne_ancienne"
display_name = "Mère Yvenne"
role = "Ancienne du village"
dialogues = PackedStringArray("L\'aube a toujours été ainsi, enfant. Depuis ma naissance, depuis celle de ma mère. On ne questionne pas une bénédiction.", "Parfois le silence de la forêt me pèse plus que le froid ne m\'a jamais pesé ailleurs.", "Il y a des motifs, sous l\'écorce des vieux arbres, qui ne ressemblent à rien de naturel. Mais qui suis-je pour m\'en inquiéter.")
quests = [{
"entry_id": "quest_silence_bois",
"name": "Le Silence des Bois",
"quest_id": "silence_des_bois",
"spawn": {
"condition": {
"quest_id": "intro_peche",
"state": "completed",
"type": "quest"
},
"cooldown_seconds": null,
"hint": "Mère Yvenne semble soucieuse du calme inhabituel qui règne dans les bois.",
"mode": "conditional",
"stock": null,
"visibility_when_locked": "hinted"
}
}, {
"entry_id": "quest_offrandes_aube",
"name": "Offrandes à l'Aube",
